# =============================================================================
# RenovateAI — Environment Variables
# Copy to .env.local for development. Never commit .env.local.
# =============================================================================

# ---- Core ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000/widget.js
NODE_ENV=development

# ---- Database (Postgres via Supabase or Neon) ----
DATABASE_URL=postgres://postgres:password@localhost:5432/renovateai
DATABASE_URL_POOLED=postgres://postgres:password@localhost:5432/renovateai

# ---- Auth (Clerk) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ---- AI providers ----
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-4-6
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# Fal.ai (primary FLUX provider)
FAL_API_KEY=fal_xxx

# Replicate (fallback FLUX + SAM 2)
REPLICATE_API_TOKEN=r8_xxx

# Voyage (embeddings)
VOYAGE_API_KEY=pa-xxx

# ---- Storage (Cloudflare R2) ----
R2_ACCOUNT_ID=xxx
R2_ACCESS_KEY_ID=xxx
R2_SECRET_ACCESS_KEY=xxx
R2_BUCKET_PHOTOS=renovateai-photos
R2_BUCKET_RENDERS=renovateai-renders
R2_PUBLIC_URL=https://cdn.renovateai.com

# ---- Workflow engine ----
INNGEST_EVENT_KEY=xxx
INNGEST_SIGNING_KEY=signkey-xxx

# ---- Comms ----
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@renovateai.com
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+15555555555

# ---- Payments ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ---- CRM integrations (per-tenant credentials are stored encrypted in DB) ----
GHL_OAUTH_CLIENT_ID=xxx
GHL_OAUTH_CLIENT_SECRET=xxx
HUBSPOT_OAUTH_CLIENT_ID=xxx
HUBSPOT_OAUTH_CLIENT_SECRET=xxx

# ---- Encryption (for storing per-tenant API keys at rest) ----
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ---- Observability ----
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ---- Feature flags ----
ENABLE_VOICE_AGENTS=false
ENABLE_SEO_GENERATOR=false
ENABLE_WHITE_LABEL=false
